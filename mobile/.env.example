# Copy this file to .env. Address of the Go backend, reachable from your phone (same Wi-Fi).
# Find your laptop's LAN IP with: ipconfig getifaddr en0
EXPO_PUBLIC_API_URL=http://192.168.0.10:8080
# Only for a Runpod endpoint: https://ENDPOINT_ID.api.runpod.ai and a restricted API key.
# EXPO_PUBLIC_API_KEY=
